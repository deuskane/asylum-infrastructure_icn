name        : asylum:infrastructure:icn:1.3.4
description : Interconnection

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/icn_pkg.vhd
      - hdl/sbi_default_slave.vhd
      - hdl/sbi_pipe.vhd
      - hdl/sbi_icn_mux_mst.vhd
      - hdl/sbi_icn_mux_tgt.vhd
      - hdl/sbi_icn.vhd
      - hdl/sbi_wrapper_target.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    depend       :
      - asylum:utils:pkg


  #---------------------------------------
  sim_basic:
  #---------------------------------------
    files        :
      - sim/tb_sbi_icn_pkg.vhd
      - sim/tb_sbi_icn_tc1_pkg.vhd
      - sim/tb_sbi_icn_tc2_pkg.vhd
      - sim/tb_sbi_icn_tc3_pkg.vhd
      - sim/tb_sbi_icn_tc4_pkg.vhd
      - sim/tb_sbi_icn_suite_pkg.vhd
      - sim/tb_sbi_icn.vhd
    file_type    : vhdlSource-2008
    #logical_name : asylum
    depend       :
      - bitvis:verification:uvvm


#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl

  #---------------------------------------
  sim_basic:
  #---------------------------------------
    << : *default
    description     : Simulation of basic unit tests
    filesets_append :
      - sim_basic
    toplevel        : tb_sbi_icn
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable","--assert-level=error"]

  #---------------------------------------
  sim_pipe:
  #---------------------------------------
    << : *default
    description     : Simulation of basic unit tests with sbi_pipe on all master and target ports
    filesets_append :
      - sim_basic
    toplevel        : tb_sbi_icn
    parameters      :
      - PIPEIN=true
      - PIPEOUT=true
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable","--assert-level=error"]

  #---------------------------------------
  sim_soc:
  #---------------------------------------
    << : *default
    description     : Simulation of basic unit tests with the SoC configuration (fix, or, external default slave, wait states)
    filesets_append :
      - sim_basic
    toplevel        : tb_sbi_icn
    parameters      :
      - MASTER_SEL=fix
      - TARGET_SEL=or
      - INTERNAL_DEFAULT_SLAVE=false
      - WAIT_STATES=2
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable","--assert-level=error"]

  #---------------------------------------
  sim_one_hot:
  #---------------------------------------
    << : *default
    description     : Simulation of basic unit tests with one-hot address decoding (roundrobin, or, wait states)
    filesets_append :
      - sim_basic
    toplevel        : tb_sbi_icn
    parameters      :
      - TARGET_ADDR_ENCODING=one_hot
      - TARGET_SEL=or
      - WAIT_STATES=1
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable","--assert-level=error"]

#=========================================
parameters :
#=========================================

  PIPEIN :
    description : Testbench only, insert an sbi_pipe stage on every master port
    datatype    : bool
    default     : false
    paramtype   : generic

  PIPEOUT :
    description : Testbench only, insert an sbi_pipe stage on every target port
    datatype    : bool
    default     : false
    paramtype   : generic

  MASTER_SEL :
    description : Testbench only, arbitration of the interconnect ("fix" / "roundrobin")
    datatype    : str
    default     : roundrobin
    paramtype   : generic

  TARGET_SEL :
    description : Testbench only, response merge of the interconnect ("or" / "mux")
    datatype    : str
    default     : mux
    paramtype   : generic

  TARGET_ADDR_ENCODING :
    description : Testbench only, address decoding of the interconnect ("binary" / "one_hot")
    datatype    : str
    default     : binary
    paramtype   : generic

  INTERNAL_DEFAULT_SLAVE :
    description : Testbench only, false connects the default slave (memory model) to the last target port
    datatype    : bool
    default     : true
    paramtype   : generic

  WAIT_STATES :
    description : Testbench only, target i answers after WAIT_STATES*i cycles
    datatype    : int
    default     : 0
    paramtype   : generic
