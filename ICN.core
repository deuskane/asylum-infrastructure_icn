name        : asylum:infrastructure:icn:1.3.4
description : Interconnection

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/icn_pkg.vhd
      - hdl/sbi_default_slave.vhd
      - hdl/sbi_pipe.vhd
      - hdl/sbi_icn_mux_mst.vhd
      - hdl/sbi_icn_mux_tgt.vhd
      - hdl/sbi_icn.vhd
      - hdl/sbi_wrapper_target.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    depend       :
      - asylum:utils:pkg


  #---------------------------------------
  sim_basic:
  #---------------------------------------
    files        :
      - sim/tb_sbi_icn_pkg.vhd
      - sim/tb_sbi_icn_tc1_pkg.vhd
      - sim/tb_sbi_icn_tc2_pkg.vhd
      - sim/tb_sbi_icn_tc3_pkg.vhd
      - sim/tb_sbi_icn_suite_pkg.vhd
      - sim/tb_sbi_icn.vhd
    file_type    : vhdlSource-2008
    #logical_name : asylum
    depend       :
      - bitvis:verification:uvvm


  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/sbi_icn_wrapper.vhd
    file_type    : vhdlSource-2008
    logical_name : asylum
    depend       :
      - ">=asylum:utils:generators:2.8.0"

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_icn_wrapper)
    toplevel        : asylum.sbi_icn_wrapper
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of sbi_icn_wrapper with the generics of the target.
  # The pre_run hook (ghdl_synth.sh of asylum:utils:generators) adds
  # ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of sbi_icn_wrapper, PicoSoC ICN2 (default generics)
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_picosoc_icn1 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_icn_wrapper, PicoSoC ICN1
    parameters      :
      - ADDR_MAP=picosoc_icn1
      - INTERNAL_DEFAULT_SLAVE=false

  #---------------------------------------
  lint_ghdl_synth_picosoc_rr :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_icn_wrapper, PicoSoC ICN2 with 2 masters roundrobin
    parameters      :
      - NB_MASTER=2
      - MASTER_SEL=roundrobin

  #---------------------------------------
  lint_ghdl_synth_tb :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_icn_wrapper, address map of tb_sbi_icn
    parameters      :
      - NB_MASTER=2
      - MASTER_SEL=roundrobin
      - TARGET_SEL=mux
      - ADDR_MAP=tb

  #---------------------------------------
  lint_ghdl_synth_tb_pipe :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_icn_wrapper, address map of tb_sbi_icn with sbi_pipe
    parameters      :
      - NB_MASTER=2
      - MASTER_SEL=roundrobin
      - TARGET_SEL=mux
      - ADDR_MAP=tb
      - PIPEIN=true
      - PIPEOUT=true

  #---------------------------------------
  lint_ghdl_synth_one_hot :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_icn_wrapper, 3 masters, 4 targets one_hot
    parameters      :
      - NB_MASTER=3
      - ADDR_MAP=one_hot

  #---------------------------------------
  sim_basic:
  #---------------------------------------
    << : *default
    description     : Simulation of basic unit tests
    filesets_append :
      - sim_basic
    toplevel        : tb_sbi_icn
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable","--assert-level=error"]

  #---------------------------------------
  sim_pipe:
  #---------------------------------------
    << : *default
    description     : Simulation of basic unit tests with sbi_pipe on all master and target ports
    filesets_append :
      - sim_basic
    toplevel        : tb_sbi_icn
    parameters      :
      - PIPEIN=true
      - PIPEOUT=true
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable","--assert-level=error"]

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

#=========================================
parameters :
#=========================================

  PIPEIN :
    description : Testbench only, insert an sbi_pipe stage on every master port
    datatype    : bool
    default     : false
    paramtype   : generic

  PIPEOUT :
    description : Testbench only, insert an sbi_pipe stage on every target port
    datatype    : bool
    default     : false
    paramtype   : generic

  #---------------------------------------
  # Generics of sbi_icn_wrapper (lint_ghdl_synth_*)
  #---------------------------------------
  NB_MASTER :
    description : Number of masters
    datatype    : int
    default     : 1
    paramtype   : generic

  MASTER_SEL :
    description : Master arbitration (fix / roundrobin)
    datatype    : str
    default     : fix
    paramtype   : generic

  TARGET_SEL :
    description : Target read data selection (or / mux)
    datatype    : str
    default     : or
    paramtype   : generic

  ADDR_MAP :
    description : Address map of sbi_icn_wrapper (picosoc_icn2 / picosoc_icn1 / tb / one_hot)
    datatype    : str
    default     : picosoc_icn2
    paramtype   : generic

  INTERNAL_DEFAULT_SLAVE :
    description : true, internal default slave
    datatype    : bool
    default     : true
    paramtype   : generic
